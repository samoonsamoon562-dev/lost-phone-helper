<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lost Phone Helper</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #101418;
      color: white;
    }

    .container {
      width: 92%;
      max-width: 500px;
      margin: 40px auto;
    }

    .card {
      background: #1b2229;
      padding: 25px;
      border-radius: 18px;
      margin-bottom: 20px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.3);
    }

    h1 {
      text-align: center;
      margin-bottom: 8px;
    }

    .subtitle {
      text-align: center;
      color: #aeb7c0;
      margin-bottom: 25px;
    }

    label {
      display: block;
      margin: 15px 0 7px;
      color: #cbd3da;
    }

    input,
    textarea {
      width: 100%;
      padding: 13px;
      border: none;
      border-radius: 10px;
      background: #2a333c;
      color: white;
      font-size: 16px;
      outline: none;
    }

    textarea {
      min-height: 100px;
      resize: vertical;
    }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 15px;
      border: none;
      border-radius: 10px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .login-btn {
      background: #3b82f6;
      color: white;
    }

    .save-btn {
      background: #16a34a;
      color: white;
    }

    .lost-btn {
      background: #dc2626;
      color: white;
    }

    .logout-btn {
      background: #4b5563;
      color: white;
    }

    .status {
      text-align: center;
      padding: 12px;
      border-radius: 10px;
      background: #26313a;
      margin-top: 15px;
    }

    .hidden {
      display: none;
    }

    .danger {
      color: #ff6b6b;
      font-weight: bold;
    }

    .success {
      color: #4ade80;
      font-weight: bold;
    }
  </style>
</head>

<body>

  <div class="container">

    <div class="card" id="loginCard">
      <h1>📱 Lost Phone Helper</h1>

      <p class="subtitle">
        Owner Login
      </p>

      <label>Email</label>
      <input type="email" id="email" placeholder="Your email">

      <label>Password</label>
      <input type="password" id="password" placeholder="Your password">

      <button class="login-btn" id="loginBtn">
        Login
      </button>

      <p id="loginStatus"></p>
    </div>


    <div class="card hidden" id="dashboard">

      <h1>📱 Lost Phone Helper</h1>

      <p class="subtitle">
        Owner Dashboard
      </p>

      <label>Owner Name</label>
      <input type="text" id="ownerName" placeholder="Your name">

      <label>Contact Number</label>
      <input type="text" id="contact" placeholder="Phone number">

      <label>Reward</label>
      <input type="text" id="reward" placeholder="Example: $100">

      <button class="save-btn" id="saveBtn">
        Save Information
      </button>


      <hr style="margin:25px 0;border-color:#333;">


      <label>Lost Phone Message</label>

      <textarea id="lostMessage"
        placeholder="Example: This phone is lost. Please contact the owner."></textarea>


      <button class="lost-btn" id="lostModeBtn">
        🔴 Turn Lost Mode ON
      </button>


      <div class="status" id="lostStatus">
        Lost Mode: OFF
      </div>


      <button class="logout-btn" id="logoutBtn">
        Logout
      </button>

    </div>

  </div>


  <script type="module">

    import { initializeApp } from
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

    import {
      getAuth,
      signInWithEmailAndPassword,
      onAuthStateChanged,
      signOut
    } from
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

    import {
      getDatabase,
      ref,
      set,
      get,
      update
    } from
      "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";


    const firebaseConfig = {
      apiKey: "AIzaSyDKpQ-GoohLHNxe8kKAn2czsuAaWZjs2DM",
      authDomain: "lost-phone-helper-4b5ac.firebaseapp.com",
      databaseURL: "https://lost-phone-helper-4b5ac-default-rtdb.firebaseio.com",
      projectId: "lost-phone-helper-4b5ac",
      storageBucket: "lost-phone-helper-4b5ac.firebasestorage.app",
      messagingSenderId: "159640605772",
      appId: "1:159640605772:web:1f2374a362735fd19fd0e9",
      measurementId: "G-G3CPYE7NMN"
    };


    const app = initializeApp(firebaseConfig);

    const auth = getAuth(app);

    const database = getDatabase(app);


    const loginCard = document.getElementById("loginCard");
    const dashboard = document.getElementById("dashboard");

    const loginBtn = document.getElementById("loginBtn");
    const logoutBtn = document.getElementById("logoutBtn");

    const saveBtn = document.getElementById("saveBtn");
    const lostModeBtn = document.getElementById("lostModeBtn");

    const loginStatus = document.getElementById("loginStatus");

    const ownerName = document.getElementById("ownerName");
    const contact = document.getElementById("contact");
    const reward = document.getElementById("reward");
    const lostMessage = document.getElementById("lostMessage");

    const lostStatus = document.getElementById("lostStatus");


    let currentUser = null;
    let lostMode = false;


    loginBtn.addEventListener("click", async () => {

      const email = document.getElementById("email").value.trim();
      const password = document.getElementById("password").value;

      if (!email || !password) {
        loginStatus.textContent = "Email and password are required.";
        loginStatus.className = "danger";
        return;
      }

      try {

        await signInWithEmailAndPassword(
          auth,
          email,
          password
        );

        loginStatus.textContent = "Login successful.";
        loginStatus.className = "success";

      } catch (error) {

        console.error(error);

        loginStatus.textContent =
          "Login failed. Check your email and password.";

        loginStatus.className = "danger";
      }

    });


    onAuthStateChanged(auth, async (user) => {

      if (user) {

        currentUser = user;

        loginCard.classList.add("hidden");
        dashboard.classList.remove("hidden");

        await loadUserData();

      } else {

        currentUser = null;

        loginCard.classList.remove("hidden");
        dashboard.classList.add("hidden");

      }

    });


    async function loadUserData() {

      if (!currentUser) return;

      const userRef =
        ref(database, "users/" + currentUser.uid);

      try {

        const snapshot = await get(userRef);

        if (snapshot.exists()) {

          const data = snapshot.val();

          ownerName.value = data.name || "";
          contact.value = data.contact || "";
          reward.value = data.reward || "";
          lostMessage.value = data.message || "";

          lostMode = data.lostMode === true;

          updateLostModeUI();

        }

      } catch (error) {

        console.error(error);

      }

    }


    saveBtn.addEventListener("click", async () => {

      if (!currentUser) return;

      try {

        await update(
          ref(database, "users/" + currentUser.uid),
          {
            name: ownerName.value.trim(),
            contact: contact.value.trim(),
            reward: reward.value.trim(),
            message: lostMessage.value.trim()
          }
        );

        alert("Information saved.");

      } catch (error) {

        console.error(error);

        alert("Could not save information.");

      }

    });


    lostModeBtn.addEventListener("click", async () => {

      if (!currentUser) return;

      lostMode = !lostMode;

      try {

        await update(
          ref(database, "users/" + currentUser.uid),
          {
            name: ownerName.value.trim(),
            contact: contact.value.trim(),
            reward: reward.value.trim(),
            message: lostMessage.value.trim(),
            lostMode: lostMode,
            updatedAt: Date.now()
          }
        );

        updateLostModeUI();

      } catch (error) {

        console.error(error);

        lostMode = !lostMode;

        alert("Could not change Lost Mode.");

      }

    });


    function updateLostModeUI() {

      if (lostMode) {

        lostModeBtn.textContent =
          "🟢 Turn Lost Mode OFF";

        lostModeBtn.style.background =
          "#16a34a";

        lostStatus.textContent =
          "Lost Mode: ON";

        lostStatus.style.color =
          "#4ade80";

      } else {

        lostModeBtn.textContent =
          "🔴 Turn Lost Mode ON";

        lostModeBtn.style.background =
          "#dc2626";

        lostStatus.textContent =
          "Lost Mode: OFF";

        lostStatus.style.color =
          "#ff6b6b";

      }

    }


    logoutBtn.addEventListener("click", async () => {

      await signOut(auth);

    });

  </script>

</body>
</html>